# Copier ce fichier en « .env » (jamais envoyé sur GitHub) et remplir les valeurs.

# Mode développement en local (False en production)
DEBUG=True
# Longue chaîne aléatoire, obligatoire en production
SECRET_KEY=
# Domaines autorisés, séparés par des virgules
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
# Base Neon (postgresql://…?sslmode=require). Vide = SQLite en local
DATABASE_URL=
# Adresse(s) du front autorisée(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# Limites de débit par adresse IP
LIMITE_CONTACT=5/hour
LIMITE_CHAT=20/hour

# Chatbot (étape 14)
GROQ_API_KEY=
GROQ_MODEL=

# Notification par email des messages du formulaire (facultatif)
CONTACT_NOTIFY_EMAIL=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
